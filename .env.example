NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Local Ollama endpoint. For Vercel, replace this with a secured public HTTPS proxy or tunnel URL.
OLLAMA_BASE_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1:8b
# Optional: only when the proxy or remote Ollama-compatible host validates bearer tokens.
OLLAMA_API_KEY=
OLLAMA_KEEP_ALIVE=-1m
OLLAMA_PROXY_PORT=11435
OLLAMA_PROXY_MAX_CONCURRENT=2

